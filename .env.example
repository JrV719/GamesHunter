# --- Base de datos -------------------------------------------------------
# Desarrollo (por defecto): SQLite vía node:sqlite, cero instalación.
DATABASE_URL="file:./dev.db"

# Producción en Vercel: Turso Cloud con el motor libSQL. Mismo dialecto SQLite,
# así que las consultas del proyecto no cambian. Crea la base en
# https://turso.tech (motor libSQL, NO el preview "Turso Database") y copia la
# URL y el token desde el panel.
#
# En Vercel se usan los nombres que documenta Turso:
#   TURSO_DATABASE_URL="libsql://gameshunter-tu8xxxxx.turso.io"
#   TURSO_AUTH_TOKEN="eyJhbGciOi..."
# También se aceptan DATABASE_URL / DATABASE_AUTH_TOKEN y LIBSQL_*.
#
# IMPORTANTE: en Vercel el sistema de ficheros es de sólo lectura, así que
# `file:./dev.db` NO funciona. Sin una URL remota la aplicación lo detecta y lo
# explica en /api/health, pero no puede mostrar el catálogo.

# Postgres: el modelo ya es relacional y portable, pero GamesHunter despliega
# con libSQL. Si algún día migras, consulta la sección «Migrar a PostgreSQL»
# del README antes de cambiar esta variable.

# --- Sitio ---------------------------------------------------------------
# Origen público del sitio, sin barra final. Se usa para las URLs canónicas,
# Open Graph, robots.txt y sitemap.xml.
# Si no la defines, la aplicación usa automáticamente el dominio que Vercel
# inyecta en el despliegue (VERCEL_PROJECT_PRODUCTION_URL / VERCEL_URL).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="Games Hunter"

# --- Seguridad -----------------------------------------------------------
# Secreto para firmar las cookies de sesión (OBLIGATORIO en producción).
# Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="dev-secret-cambialo-en-produccion-0000000000"

# Credenciales del administrador inicial que crea el seed.
ADMIN_EMAIL="admin@gameshunter.app"
ADMIN_PASSWORD="gameshunter"
ADMIN_USERNAME="admin"

# --- Datos de demostración ----------------------------------------------
# Ponlo en false para no insertar los juegos de ejemplo.
# Los temas del foro se siembran siempre, aunque esté a false.
SEED_DEMO_DATA="true"