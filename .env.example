# --- Base de datos -------------------------------------------------------
# Desarrollo (por defecto): SQLite vía node:sqlite, cero instalación.
DATABASE_URL="file:./dev.db"

# Producción: PostgreSQL. El modelo ya es relacional y portable; consulta
# la sección "Migrar a PostgreSQL" del README.
# DATABASE_URL="postgresql://usuario:password@localhost:5432/gameshunter?schema=public"

# --- Sitio ---------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="GamesHunter"

# --- Seguridad -----------------------------------------------------------
# Secreto para firmar las cookies de sesión (obligatorio en producción).
# Genera uno con:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="dev-secret-cambialo-en-produccion-0000000000"

# Credenciales del administrador inicial que crea el seed.
ADMIN_EMAIL="admin@gameshunter.app"
ADMIN_PASSWORD="gameshunter"
ADMIN_USERNAME="admin"

# --- Datos de demostración ----------------------------------------------
# Ponlo en false para no insertar los juegos de ejemplo.
SEED_DEMO_DATA="true"
