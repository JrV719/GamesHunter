# --- Base de datos -------------------------------------------------------
# Desarrollo (por defecto): SQLite vía node:sqlite, cero instalación.
DATABASE_URL="file:./dev.db"

# Producción en Vercel: Turso / libSQL. Mismo dialecto SQLite, así que las
# consultas del proyecto no cambian. Crea una base con:
#   npx turso db create gameshunter
#   npx turso db tokens create gameshunter
# y pega aquí la URL y el token.
# DATABASE_URL="libsql://gameshunter-tu8xxxxx.turso.io"
# DATABASE_AUTH_TOKEN="eyJhbGciOi..."

# Postgres: el modelo ya es relacional y portable, pero GamesHunter despliega
# con libSQL. Si algún día migras, consulta la sección «Migrar a PostgreSQL»
# del README antes de cambiar esta variable.

# --- Sitio ---------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="Games Hunter"

# --- Seguridad -----------------------------------------------------------
# Secreto para firmar las cookies de sesión (OBLIGATORIO en producción).
# Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="dev-secret-cambialo-en-produccion-0000000000"

# Credenciales del administrador inicial que crea el seed.
ADMIN_EMAIL="admin@gameshunter.app"
ADMIN_PASSWORD="gameshunter"
ADMIN_USERNAME="admin"

# --- Datos de demostración ----------------------------------------------
# Ponlo en false para no insertar los juegos de ejemplo.
# Los temas del foro se siembran siempre, aunque esté a false.
SEED_DEMO_DATA="true"