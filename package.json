{
  "name": "games-hunter",
  "version": "1.0.0",
  "private": true,
  "description": "Games Hunter - Base de datos y guias de trofeos de PS4 y PS5",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "typecheck": "tsc --noEmit",
    "db:push": "node scripts/db-push.mjs",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "node scripts/db-push.mjs --reset",
    "db:export": "node scripts/db-export.mjs",
    "db:verify": "node scripts/db-verify.mjs",
    "covers": "node scripts/fetch-covers.mjs",
    "setup": "npm run db:push && npm run db:seed",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "@prisma/client": "^7.10.0",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^2.5.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prisma": "^8.0.0-rc.19",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
